{
    "name": "jos-staypuft",
    "description": "A personal blogging theme for Ghost. Beautiful, minimal and responsive.",
    "homepage": "https://github.com/joseftw/JOS.StayPuft",
    "demo": "https://josef.codes",
    "version": "5.0.0",
    "engines": {
        "ghost": ">=4.0.0"
    },
    "license": "MIT",
    "scripts": {
        "dev": "node build.js --watch",
        "build": "node build.js",
        "zip": "node build.js --zip",
        "test": "gscan .",
        "preship": "yarn test",
        "ship": "STATUS=$(git status --porcelain); echo $STATUS; if [ -z \"$STATUS\" ]; then yarn version && git push --follow-tags; fi"
    },
    "author": {
        "name": "Josef Ottosson",
        "email": "no@localhost.local",
        "url": "https://github.com/joseftw"
    },
    "gpm": {
        "type": "theme",
        "categories": [
            "Minimal",
            "Personal Blogs"
        ]
    },
    "keywords": [
        "ghost",
        "theme",
        "ghost-theme"
    ],
    "repository": {
        "type": "git",
        "url": "https://github.com/joseftw/JOS.StayPuft.git"
    },
    "bugs": "https://github.com/joseftw/JOS.StayPuft/issues",
    "contributors": [
        "https://github.com/joseftw/JOS.StayPuft/graphs/contributors"
    ],
    "devDependencies": {
        "archiver": "^7.0.1",
        "autoprefixer": "^10.4.19",
        "terser": "^5.31.0",
        "cssnano": "^7.0.1",
        "gscan": "5.1.0",
        "postcss": "^8.4.38",
        "postcss-color-function": "^4.1.0",
        "postcss-custom-properties": "^13.3.10",
        "postcss-easy-import": "^4.0.0",
        "terser": "^5.44.0",
        "vite": "^6.0.0"
    },
    "config": {
        "card_assets": false,
        "posts_per_page": 5,
        "image_sizes": {
            "xxs": {
                "width": 30
            },
            "xs": {
                "width": 100
            },
            "s": {
                "width": 300
            },
            "m": {
                "width": 600
            },
            "l": {
                "width": 1000
            },
            "xl": {
                "width": 2000
            }
        }
    }
}
