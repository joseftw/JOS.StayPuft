{
    "name": "jos-staypuft",
    "description": "A personal blogging theme for Ghost. Beautiful, minimal and responsive.",
    "homepage": "https://github.com/joseftw/JOS.StayPuft",
    "demo": "https://josef.codes",
    "version": "5.0.0",
    "engines": {
        "ghost": ">=4.0.0"
    },
    "license": "MIT",
    "scripts": {
        "dev": "node build.js --watch",
        "build": "node build.js",
        "zip": "node build.js --zip",
        "test": "gscan .",
        "preship": "npm test",
        "ship": "STATUS=$(git status --porcelain); echo $STATUS; if [ -z \"$STATUS\" ]; then npm version patch && git push --follow-tags; fi",
        "static:fetch": "node scripts/fetch-ghost-content.js",
        "static:build": "node scripts/static-build.js",
        "static:serve": "node scripts/static-build.js --serve",
        "static:deploy": "node scripts/static-build.js",
        "static:sample": "node scripts/create-sample-data.js"
    },
    "author": {
        "name": "Josef Ottosson",
        "email": "no@localhost.local",
        "url": "https://github.com/joseftw"
    },
    "gpm": {
        "type": "theme",
        "categories": [
            "Minimal",
            "Personal Blogs"
        ]
    },
    "keywords": [
        "ghost",
        "theme",
        "ghost-theme"
    ],
    "repository": {
        "type": "git",
        "url": "https://github.com/joseftw/JOS.StayPuft.git"
    },
    "bugs": "https://github.com/joseftw/JOS.StayPuft/issues",
    "contributors": [
        "https://github.com/joseftw/JOS.StayPuft/graphs/contributors"
    ],
    "devDependencies": {
        "@11ty/eleventy": "^3.1.2",
        "@11ty/eleventy-plugin-handlebars": "^1.0.0",
        "@rollup/plugin-terser": "^0.4.4",
        "@tryghost/content-api": "^1.12.0",
        "autoprefixer": "^10.4.19",
        "cssnano": "^7.0.1",
        "gscan": "5.1.0",
        "handlebars": "^4.7.8",
        "moment": "^2.30.1",
        "postcss": "^8.4.38",
        "postcss-color-function": "^4.1.0",
        "postcss-custom-properties": "^13.3.10",
        "postcss-easy-import": "^4.0.0",
        "rollup": "^4.52.3"
    },
    "optionalDependencies": {
        "@11ty/eleventy": "^3.0.0",
        "@11ty/eleventy-plugin-handlebars": "^1.0.0",
        "@tryghost/content-api": "^1.11.21",
        "handlebars": "^4.7.8",
        "moment": "^2.30.1"
    },
    "config": {
        "card_assets": false,
        "posts_per_page": 5,
        "image_sizes": {
            "xxs": {
                "width": 30
            },
            "xs": {
                "width": 100
            },
            "s": {
                "width": 300
            },
            "m": {
                "width": 600
            },
            "l": {
                "width": 1000
            },
            "xl": {
                "width": 2000
            }
        }
    }
}
