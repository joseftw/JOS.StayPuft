---
pagination:
  data: collections.tagList
  size: 1
  alias: tag
permalink: /tag/{{ tag | slugify }}/
layout: base.njk
bodyClass: tag-template
---

<header class="page-header">
    <h1>{{ tag }}</h1>
    <p>A collection of {{ collections.posts | filterByTag(tag) | length }} post{% if (collections.posts | filterByTag(tag) | length) != 1 %}s{% endif %}</p>
</header>

<div class="post-feed">
    {% set taggedPosts = collections.posts | filterByTag(tag) %}
    {% for post in taggedPosts %}
    <article class="post-card{% if post.data.featured %} featured{% endif %}{% if not post.data.feature_image %} no-image{% endif %}">
        
        {% if post.data.feature_image %}
        <a class="post-card-image-link" href="{{ post.url }}">
            <img class="post-card-image"
                src="{{ post.data.feature_image }}"
                alt="{{ post.data.title }}"
                loading="lazy"
            />
        </a>
        {% endif %}

        <div class="post-card-content">

            <a class="post-card-content-link" href="{{ post.url }}">

                <header class="post-card-header">
                    {% if post.data.tags and post.data.tags.length > 0 %}
                        <span class="post-card-tags"><i class='fa fa-tag'></i> {{ post.data.tags[0] }}</span>
                    {% endif %}
                    <h2 class="post-card-title">{{ post.data.title }}</h2>
                </header>

                <section class="post-card-excerpt">
                    <p>{{ post.data.excerpt or (post.templateContent | striptags | truncate(200)) }}</p>
                </section>

            </a>

            <footer class="post-card-meta">

                <span class="post-time">
                    <i class='fa fa-calendar'></i>
                    <time datetime="{{ post.data.date | dateFormat('YYYY-MM-DD') }}" class="fulldate">{{ post.data.date | dateFormat('MMMM Do, YYYY') }}</time>
                </span>

                {% if post.data.featured %}
                <span class="featured-badge">Featured</span>
                {% endif %}

            </footer>

        </div><!--/.post-card-content-->

    </article>
    {% endfor %}
</div>
