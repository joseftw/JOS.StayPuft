# Ghost Content API Configuration
# 
# For static site generation, you need to configure Ghost API access.
# 
# 1. Copy this file to .env
# 2. Get your API key from Ghost Admin → Integrations → Add custom integration
# 3. Fill in your Ghost URL and API key below

# Your Ghost instance URL (without trailing slash)
# Examples:
#   - Self-hosted: https://blog.example.com
#   - Ghost(Pro): https://yourblog.ghost.io
#   - Local development: http://localhost:2368
GHOST_API_URL=https://demo.ghost.io

# Your Ghost Content API Key
# Get this from: Ghost Admin → Settings → Integrations → Add custom integration
GHOST_CONTENT_API_KEY=your_content_api_key_here
