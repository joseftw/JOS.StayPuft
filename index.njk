---
layout: base.njk
title: Home
---

<div class="post-feed">
    {% for post in collections.posts %}
    <article class="post-card{% if post.data.featured %} featured{% endif %}">
        {% if post.data.feature_image %}
        <a class="post-card-image-link" href="{{ post.url }}">
            <img class="post-card-image" src="{{ post.data.feature_image }}" alt="{{ post.data.title }}">
        </a>
        {% endif %}
        <div class="post-card-content">
            <h2 class="post-card-title">
                <a href="{{ post.url }}">{{ post.data.title }}</a>
            </h2>
            <div class="post-card-excerpt">
                {{ post.data.excerpt or (post.templateContent | excerpt(200)) }}
            </div>
            <div class="post-card-meta">
                <time datetime="{{ post.date }}">{{ post.date | dateFormat }}</time>
                {% if post.data.tags %}
                <span class="post-card-tags">
                    {% for tag in post.data.tags %}
                    <span class="tag">{{ tag }}</span>
                    {% endfor %}
                </span>
                {% endif %}
            </div>
        </div>
    </article>
    {% endfor %}
</div>
