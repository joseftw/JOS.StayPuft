---
pagination:
  data: collections.authorList
  size: 1
  alias: author
permalink: /author/{{ author | slugify }}/
layout: base.njk
bodyClass: author-template
---

<header class="page-header">
    <h1>{{ author }}</h1>
    <p>{{ collections.posts | filterByAuthor(author) | length }} posts</p>
</header>

<div class="post-feed">
    {% set authorPosts = collections.posts | filterByAuthor(author) %}
    {% for post in authorPosts %}
    <article class="post-card{% if post.data.featured %} featured{% endif %}{% if not post.data.feature_image %} no-image{% endif %}">
        {% if post.data.feature_image %}
        <a class="post-card-image-link" href="{{ post.url }}">
            <img class="post-card-image" src="{{ post.data.feature_image }}" alt="{{ post.data.title }}">
        </a>
        {% endif %}
        <div class="post-card-content">
            <a class="post-card-content-link" href="{{ post.url }}">
                <header class="post-card-header">
                    {% if post.data.tags and post.data.tags.length > 0 %}
                    <div class="post-card-tags">
                        {{ post.data.tags[0] }}
                    </div>
                    {% endif %}
                    <h2 class="post-card-title">{{ post.data.title }}</h2>
                </header>
                <section class="post-card-excerpt">
                    <p>{{ post.data.excerpt or post.templateContent | striptags | truncate(150) }}</p>
                </section>
            </a>
            <footer class="post-card-meta">
                <div class="post-card-byline-content">
                    <span class="post-card-byline-date">
                        <time datetime="{{ post.date }}">{{ post.date | dateFormat }}</time>
                    </span>
                </div>
            </footer>
        </div>
    </article>
    {% endfor %}
</div>
