---
layout: base.njk
---

<article class="page">
    <header class="page-header">
        <h1 class="page-title">{{ title }}</h1>
    </header>
    
    {% if feature_image %}
    <figure class="page-feature-image">
        <img src="{{ feature_image }}" alt="{{ title }}">
    </figure>
    {% endif %}
    
    <div class="page-content">
        {{ content | safe }}
    </div>
</article>
